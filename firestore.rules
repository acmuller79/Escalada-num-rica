rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Blueprint Validation Helpers
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() { return request.resource.data; }

    function isValidScore(data) {
      return data.keys().hasAll(['playerName', 'level', 'touches', 'result', 'date']) &&
             data.keys().size() == 5 &&
             data.playerName is string && data.playerName.size() >= 1 && data.playerName.size() <= 50 &&
             data.level is number && data.level >= 1 && data.level <= 100 &&
             data.touches is number && data.touches >= 0 &&
             data.result is string && data.result.matches('^(won|gameover)$') &&
             data.date is number;
    }

    // 3. Collection Rules
    match /scores/{scoreId} {
      // Anyone can read the public leaderboard
      allow read: if true;
      
      // Anyone can create a score since it's an unauthenticated game leaderboard,
      // but payload must strictly match the schema constraint.
      allow create: if isValidId(scoreId) && isValidScore(incoming());
      
      // Scores are immutable once submitted
      allow update, delete: if false;
    }
  }
}
